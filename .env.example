POLYGON_API_KEY=__SET_ME__
POLYGON_BASE_URL=__SET_ME__

# Configuración JWT — RS256 asimétrico
# Generar par de claves:
#   openssl genrsa -out jwt.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -outform DER -nocrypt -in jwt.pem | base64 -w0  → JWT_PRIVATE_KEY_BASE64
#   openssl rsa -in jwt.pem -pubout -outform DER | base64 -w0                         → JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=__SET_ME__
JWT_PUBLIC_KEY_BASE64=__SET_ME__
JWT_ACCESS_EXPIRATION=__SET_IN_VERCEL_OR_JENKINS__
REFRESH_TOKEN_HASH_SECRET_BASE64=__SET_IN_VERCEL_OR_JENKINS__
JWT_REFRESH_EXPIRATION=__SET_IN_VERCEL_OR_JENKINS__

