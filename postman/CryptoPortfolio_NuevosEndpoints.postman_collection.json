        {
          "name": "2.8 Buy idempotencia (misma key 2 veces)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fija una key estable la primera vez; se reutiliza en la segunda ejecucion.",
                  "if (!pm.environment.get('idem_key')) {",
                  "  pm.environment.set('idem_key', 'fixed-idem-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "var prev = pm.environment.get('idem_tx_id');",
                  "if (prev) {",
                  "  pm.test('mismo transactionId que la primera llamada (idempotente)', function () {",
                  "    pm.expect(json.transactionId).to.eql(prev);",
                  "  });",
                  "} else {",
                  "  pm.environment.set('idem_tx_id', json.transactionId);",
                  "  pm.test('primera llamada: transactionId guardado (re-ejecuta para verificar)', function () {",
                  "    pm.expect(json.transactionId).to.be.ok;",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Idempotency-Key", "value": "{{idem_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetSymbol\": \"CRCL\",\n  \"assetName\": \"Synthetic Test Holdings\",\n  \"assetType\": \"STOCK\",\n  \"quantity\": 1.0,\n  \"pricePerUnit\": 20.0,\n  \"fee\": 0.25,\n  \"exchange\": \"NYSE\",\n  \"broker\": \"GBM\",\n  \"currency\": \"USD\",\n  \"transactionDate\": \"2025-01-01T09:00:00-06:00\"\n}"
            },
