{
  "request": {
    "method": "GET",
    "urlPath": "/v2/cryptocurrency/quotes/latest",
    "headers": {
      "X-CMC_PRO_API_KEY": { "equalTo": "fake-api-key" }
    },
    "queryParameters": {
      "symbol": { "matches": ".*" }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "quotes-response.json",
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"]
  }
}